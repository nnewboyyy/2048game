{
  "version": 4,
  "configurations": [
    {
      "name": "MinGW",
      "includePath": [
        "${workspaceFolder}/**",
        "D:/MinGW/mingw32/include",
        "D:/MinGW/mingw32/i686-w64-mingw32/include",
        "D:/MinGW/mingw32/lib/gcc/i686-w64-mingw32/**/include",
        "D:/MinGW/mingw32/lib/gcc/i686-w64-mingw32/**/include-fixed"
      ],
      "defines": ["_DEBUG", "UNICODE", "_UNICODE"],
      "compilerPath": "D:/MinGW/mingw32/bin/g++.exe",
      "compilerArgs": ["-std=c++17"],
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x86",
      "browse": {
        "path": [
          "${workspaceFolder}",
          "D:/MinGW/mingw32/include",
          "D:/MinGW/mingw32/i686-w64-mingw32/include",
          "D:/MinGW/mingw32/lib/gcc/i686-w64-mingw32"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
